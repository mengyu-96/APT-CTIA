DEMO_MODE=false
ENABLE_PREPROCESSING=true
ENABLE_INFERENCE=true
ENABLE_TRAINING=true
SHOW_TRAINING_UI=true
ALLOW_TRAINING_REPORT_SOURCE=true
ATTRIBUTION_MIN_CONFIDENCE=0.60
ATTRIBUTION_MIN_MARGIN=0.10
ATTRIBUTION_MIN_EVIDENCE_COUNT=1

BACKEND_URL=http://backend:5001
ENABLE_UI_AUTH=true
ENABLE_SELF_REGISTRATION=true
AUTH_USERS_FILE=/app/auth_data/users.json
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SESSION_TTL_SECONDS=28800
